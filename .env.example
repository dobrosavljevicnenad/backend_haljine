# Optional overrides for `docker compose up` - copy to .env and adjust.
# Never commit the .env file.

# Admin login. Prefer a bcrypt hash: {bcrypt}$2a$10$...
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD={noop}change-me

# JWT signing secret, at least 32 characters
APP_JWT_SECRET=change-me-to-a-long-random-secret-value

# Cloudinary credentials enable image uploads (uploads answer 503 without them)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
